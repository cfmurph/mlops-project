# PROD settings. The real file is the GitHub Environment secret PROD_ENV_FILE ("production" environment);
# CI writes it to /opt/housing/envs/prod.env on the VM at each deploy. Never commit real values.
HOUSING_ENV=prod

# --- Files: Cloudflare R2 (S3-compatible) ---
# Dashboard > R2 > Create bucket (e.g. housing-prod). Then Manage API tokens > Create token (Object Read & Write, that bucket).
DATA_URI=s3://<bucket-name>/housing
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_REGION=auto

# --- MLflow runs + model registry: Neon Postgres ---
# Create a project at neon.tech and copy its connection string; keep the postgresql+psycopg:// prefix.
MLFLOW_TRACKING_URI=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# --- Airflow secrets (generate once, keep stable) ---
# openssl rand -hex 24
AIRFLOW_DB_PASSWORD=<random>
AIRFLOW_ADMIN_PASSWORD=<random>
AIRFLOW_JWT_SECRET=<random>
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=<fernet-key>

# Set by CI on deploy (the git SHA of the release); shown here so the file renders locally.
IMAGE_TAG=<git-sha>
